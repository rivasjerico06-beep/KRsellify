NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Second sign-in in front of the admin Support Chat tab.
# Set the real values in Vercel → Settings → Environment Variables. Never
# commit them: anything in this repo is readable by everyone with repo access
# and stays in git history even after the password is changed.
SUPPORT_TAB_EMAIL=support-login@example.com
SUPPORT_TAB_PASSWORD=choose-a-password

# ntfy alerts when a customer sends a support message. The ntfy app on iPhone,
# Android and desktop rings with sound whether or not a browser is open. Leave
# NTFY_TOPIC unset to turn alerts off — support still works without it.
#
# On the public ntfy.sh the topic name is the ONLY thing protecting the feed:
# anyone who knows it can read every alert and post fakes. Keep it long and
# random — never rename it to something memorable like "krsellify-support".
NTFY_TOPIC=krs-put-your-random-topic-here
# Optional. Set once the topic is reserved and made private under an ntfy
# account, which replaces guessing with a real credential.
# NTFY_TOKEN=tk_your-access-token
# Optional, defaults to https://ntfy.sh — for self-hosting.
# NTFY_SERVER=https://ntfy.example.com
