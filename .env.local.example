NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Second sign-in in front of the admin Support Chat tab.
# Set the real values in Vercel → Settings → Environment Variables. Never
# commit them: anything in this repo is readable by everyone with repo access
# and stays in git history even after the password is changed.
SUPPORT_TAB_EMAIL=support-login@example.com
SUPPORT_TAB_PASSWORD=choose-a-password

# Telegram alerts when a customer sends a support message. Telegram's own apps
# on Android, iPhone, Windows and Mac ring with sound whether or not a browser
# is open. Leave unset to turn alerts off — support still works without them.
#   1. Message @BotFather on Telegram, /newbot, copy the token
#   2. Send your new bot any message
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and read
#      result[0].message.chat.id
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token
TELEGRAM_CHAT_ID=123456789
