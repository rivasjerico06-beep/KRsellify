NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Second sign-in in front of the admin Support Chat tab.
# Set the real values in Vercel → Settings → Environment Variables. Never
# commit them: anything in this repo is readable by everyone with repo access
# and stays in git history even after the password is changed.
SUPPORT_TAB_EMAIL=support-login@example.com
SUPPORT_TAB_PASSWORD=choose-a-password

# Discord alerts when a customer sends a support message. Discord's own apps on
# iPhone, Android, Mac and Windows ring with sound whether or not a browser is
# open. Leave unset to turn alerts off — support still works without them.
#   Server Settings → Integrations → Webhooks → New Webhook →
#   pick a channel → Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000/your-webhook-token
