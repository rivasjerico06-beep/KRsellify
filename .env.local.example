NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Airwallex card payments ───────────────────────────────────────────────
# The card option at checkout appears only when CLIENT_ID and API_KEY are both
# set AND admin → payments maintenance is off. Missing keys = no card button,
# never a broken one.
#   Airwallex → Developer → API keys
AIRWALLEX_CLIENT_ID=your-airwallex-client-id
AIRWALLEX_API_KEY=your-airwallex-api-key

# "demo" (sandbox, takes no real money) or "prod". Anything other than an
# explicit "prod" stays on the sandbox, so a forgotten variable can never
# quietly start charging live cards.
AIRWALLEX_ENV=demo

# Airwallex → Developer → Webhooks → add https://YOUR-DOMAIN/api/airwallex/webhook
# → subscribe to the payment_intent events → copy that subscription's secret.
# Without this the webhook rejects every delivery, and orders would only ever
# be confirmed by shoppers who make it back to the success page.
AIRWALLEX_WEBHOOK_SECRET=your-airwallex-webhook-secret

# Where Airwallex sends the shopper back to. Must be the real https origin —
# falls back to the request origin when unset, which is wrong behind a proxy.
NEXT_PUBLIC_SITE_URL=https://www.themagaoffers.net

# RFS portal. Unavailable by default — the /rfs page shows a maintenance
# notice and /api/rfs/auth refuses lookups. Set to "off" to bring it back.
# Admin → RFS Portal keeps working either way.
# NEXT_PUBLIC_RFS_MAINTENANCE=off

# Second sign-in in front of the admin Support Chat tab.
# Set the real values in Vercel → Settings → Environment Variables. Never
# commit them: anything in this repo is readable by everyone with repo access
# and stays in git history even after the password is changed.
SUPPORT_TAB_EMAIL=support-login@example.com
SUPPORT_TAB_PASSWORD=choose-a-password

# Discord alerts when a customer sends a support message. Discord's own apps on
# iPhone, Android, Mac and Windows ring with sound whether or not a browser is
# open. Leave unset to turn alerts off — support still works without them.
#   Server Settings → Integrations → Webhooks → New Webhook →
#   pick a channel → Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000/your-webhook-token
# Optional. Everyone who can see the channel is notified anyway, but that
# depends on each person leaving it on "All Messages". Set a role id here and
# every alert pings that role, notifying its members whichever settings they
# chose. Server Settings → Roles → create one → right-click → Copy Role ID
# (Developer Mode must be on).
# DISCORD_MENTION_ROLE_ID=123456789012345678
